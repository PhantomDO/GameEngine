{
  "name": "levain",
  "version": "0.1.0",
  "description": "Moteur de jeu 3D en C++23 sur NVRHI et flecs",
  "homepage": "https://github.com/PhantomDO/Levain",
  "license": "MIT",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "doctest",
    "flecs",
    "nvrhi",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        "wayland",
        "x11"
      ]
    },
    "spdlog",
    "tracy",
    "vk-bootstrap"
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./ports"
    ]
  }
}
